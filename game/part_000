<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Prem Mandir — Diwali Mela 3D</title>
<style>
:root{--gold:#ffd66b;--glass:rgba(17,13,38,.78);--line:rgba(255,255,255,.2)}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#100b28;color:#fff;font-family:system-ui,-apple-system,Segoe UI,sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}
canvas{display:block;width:100vw;height:100vh}
#hud{position:fixed;inset:0;pointer-events:none}
.top{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.pill{background:var(--glass);border:1px solid var(--line);backdrop-filter:blur(12px);border-radius:16px;padding:9px 12px;font-size:12px;box-shadow:0 6px 24px #0005}
#playerTag{font-weight:800;color:var(--gold);font-size:14px}
#menuBar{display:flex;gap:6px;pointer-events:auto;padding:6px;flex-wrap:wrap;justify-content:flex-end;max-width:230px}#menuBar button{background:#34234e;border:1px solid #fff4;color:#fff;border-radius:11px;font-size:18px;padding:4px 9px}
#hint{position:absolute;top:66px;left:50%;transform:translateX(-50%);max-width:70vw;text-align:center;color:#fff5d4}
#toast{position:absolute;left:50%;bottom:236px;transform:translateX(-50%);background:#211638ed;border:1px solid #ffffff35;padding:10px 16px;border-radius:16px;opacity:0;transition:opacity .2s;text-align:center;max-width:86vw;font-size:13px}
#toast.show{opacity:1}
#joystick{position:absolute;left:22px;bottom:25px;width:128px;height:128px;border-radius:50%;background:#ffffff18;border:2px solid #ffffff45;pointer-events:auto;touch-action:none;box-shadow:inset 0 0 22px #0004}
#stick{position:absolute;left:39px;top:39px;width:48px;height:48px;border-radius:50%;background:linear-gradient(145deg,#ffe6a0,#ff9d3e);box-shadow:0 4px 18px #0008;border:2px solid #fff9}
.actions{position:absolute;right:16px;bottom:20px;display:grid;grid-template-columns:repeat(2,64px);gap:8px;pointer-events:auto}
.action{height:46px;border-radius:17px;border:1px solid #ffffff50;background:#251747df;color:white;font-weight:800;font-size:11px;box-shadow:0 5px 18px #0006}
.action:active,.action.on{transform:scale(.94);background:#6845a8}
#interact{grid-column:span 2;background:linear-gradient(135deg,#ffb84e,#e45d76);color:#25102b}
#shopPanel{position:absolute;left:50%;top:100px;transform:translateX(-50%);width:min(330px,92vw);padding:8px;background:#1b1230cc;border:1px solid #ffffff35;border-radius:20px;display:none;pointer-events:auto;box-shadow:0 15px 50px #0009}
#shopPanel h3{margin:0 0 4px;color:#ffdc86}#shopPanel p{display:none}
.items{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.buy{border:1px solid #ffffff35;border-radius:12px;background:#34234e;color:#fff;padding:9px 4px;font-size:11px}
#panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(370px,92vw);max-height:74vh;overflow:auto;padding:16px;background:#1b1230f5;border:1px solid #fff4;border-radius:22px;display:none;pointer-events:auto;font-size:13px;box-shadow:0 15px 50px #000a}
#panel h3{margin:0 0 10px;color:#ffdc86}.seg{display:flex;gap:6px;margin:6px 0 10px}.seg button,.pb{flex:1;padding:9px;border-radius:10px;border:1px solid #fff4;background:#34234e;color:#fff;font-size:12px}.on{background:linear-gradient(90deg,#ffcc65,#ff7c76)!important;color:#32152b!important;font-weight:800}
#panel label{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:8px 0}#panel input[type=range]{width:60%}
.row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #fff2;gap:8px}.row button{padding:6px 12px;border-radius:9px;border:0;background:#ffcc65;font-weight:800}
#bar{position:absolute;left:10px;bottom:166px;max-width:calc(100vw - 175px);display:none;gap:6px;overflow-x:auto;pointer-events:auto;padding:6px;background:#1b1230cc;border:1px solid #fff3;border-radius:16px}
.slot{min-width:46px;height:46px;border-radius:12px;border:1px solid #fff4;background:#34234e;color:#fff;font-size:22px;position:relative;padding:0}.slot small{position:absolute;right:3px;bottom:1px;font-size:10px}.slot.on{background:linear-gradient(135deg,#ffcc65,#ff7c76)}
#useBtn{grid-column:span 2;background:linear-gradient(135deg,#5fd39a,#2a9d8f);color:#06241d;font-size:11px}
#nameScreen{position:fixed;inset:0;z-index:5;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 30%,#603c8b,#130d2d 65%);padding:20px}
#nameCard{width:min(390px,100%);background:#1a1230eF;border:1px solid #ffffff35;border-radius:26px;padding:24px;box-shadow:0 20px 70px #0009;text-align:center}
#nameCard h1{font-size:29px;margin:0;color:#ffdb80}#nameCard p{color:#ded4f2;font-size:13px;line-height:1.5}
#nameInput{width:100%;padding:14px;border-radius:13px;border:1px solid #ffffff40;background:#ffffff12;color:white;font-size:16px;outline:none;margin:10px 0;user-select:text;-webkit-user-select:text}
#start{width:100%;padding:14px;border:0;border-radius:14px;background:linear-gradient(90deg,#ffcc65,#ff7c76);font-weight:900;color:#32152b;font-size:15px}
.small{font-size:10px!important;color:#bcb0d2!important}
#nameScreen{background:linear-gradient(180deg,#0b1030 0%,#1b2a5c 45%,#3a2a4f 70%,#120c22 100%)!important;overflow:auto}
#nameScreen::before{content:"";position:absolute;inset:auto 0 0 0;height:38%;background:radial-gradient(ellipse at 70% 100%,#ff9a3a55,transparent 60%),repeating-linear-gradient(90deg,#0a0818 0 14px,#120d26 14px 22px,#0a0818 22px 40px);clip-path:polygon(0 40%,8% 40%,8% 15%,15% 15%,15% 50%,26% 50%,26% 25%,34% 25%,34% 55%,48% 55%,48% 5%,56% 5%,56% 45%,70% 45%,70% 30%,80% 30%,80% 60%,92% 60%,92% 20%,100% 20%,100% 100%,0 100%);pointer-events:none}
.authc{position:relative;width:min(380px,100%);background:#0d1230ee;border:1px solid #ffffff30;border-radius:22px;padding:22px;box-shadow:0 20px 70px #000a;text-align:center}
.authc input{width:100%;box-sizing:border-box;padding:13px;border-radius:12px;border:1px solid #ffffff40;background:#ffffff14;color:#fff;font-size:16px;outline:none;margin:6px 0;user-select:text;-webkit-user-select:text}
.mlogo{font-size:30px;font-weight:900;letter-spacing:2px;background:linear-gradient(90deg,#ff9933,#fff 50%,#2fb35a);-webkit-background-clip:text;background-clip:text;color:transparent;font-style:italic}.mlogo.big{font-size:34px;line-height:1.1}
.msub{color:#ffdc86;font-weight:800;letter-spacing:2px;font-size:10px;margin:2px 0 12px}
.tabs{display:flex;gap:8px;margin:6px 0 8px}.tabs button{flex:1;padding:10px;border-radius:12px;border:1px solid #ffffff40;background:#ffffff10;color:#fff;font-weight:800}.tabs button.on{background:linear-gradient(90deg,#ffcc65,#ff7c76);color:#32152b;border:0}
#aGo{width:100%;padding:14px;border:0;border-radius:14px;background:linear-gradient(90deg,#ffcc65,#ff7c76);font-weight:900;color:#32152b;font-size:15px;margin-top:6px}
#aErr{color:#ff8c8c;font-size:12px;min-height:16px;font-weight:700}
#menuBox{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:flex-start;text-align:left}
.mleft{width:min(460px,92%);margin-left:3%}.mbtns{display:flex;flex-direction:column;gap:9px;margin-top:6px}
.mbtns button{text-align:left;padding:13px 16px;border-radius:10px;border:1px solid #ffffff30;background:#0d1530b8;color:#fff;font-weight:800;font-size:15px;letter-spacing:.5px;backdrop-filter:blur(4px)}.mbtns button:active{background:#ffffff30}
.minfo{position:absolute;top:10px;right:10px;background:#0d1530c8;border:1px solid #ffffff30;border-radius:10px;padding:10px 14px;font-size:12px;line-height:1.7;color:#dfe6ff}.minfo b{color:#fff}
.mver{position:absolute;right:12px;bottom:8px;font-size:10px;color:#cfd6f5}
.mcred{position:absolute;left:3%;bottom:4px;max-width:60%;opacity:.55;margin:0}

#interact{display:none}#ctx{position:absolute;right:12px;bottom:236px;display:flex;flex-direction:column;gap:6px;align-items:flex-end;pointer-events:auto;max-height:46vh;overflow:auto}#ctx button{background:linear-gradient(135deg,#ffb84e,#e45d76);color:#25102b;border:1px solid #fff6;border-radius:14px;padding:9px 13px;font-weight:800;font-size:12px;box-shadow:0 5px 18px #0007}

#bikeCtl{display:none;position:absolute;inset:0;pointer-events:none}body.onbike #bikeCtl{display:block}body.onbike #joystick,body.onbike .actions,body.onbike #bar{display:none!important}
#bikeCtl button{pointer-events:auto;touch-action:none;border:2px solid #fff6;color:#fff;font-weight:900;box-shadow:0 6px 22px #000a;-webkit-tap-highlight-color:transparent}
#steerBox{position:absolute;left:18px;bottom:26px;display:flex;gap:14px}#steerBox button{width:92px;height:92px;border-radius:26px;background:linear-gradient(145deg,#4a63c9,#2a3a8a);font-size:44px}
#raceBox{position:absolute;right:16px;bottom:24px;display:flex;gap:14px;align-items:flex-end}#raceBtn{width:104px;height:104px;border-radius:50%;background:linear-gradient(145deg,#6fe08a,#1e9a4a);font-size:17px}#brakeBtn{width:84px;height:84px;border-radius:50%;background:linear-gradient(145deg,#ff6a6a,#b01c2c);font-size:15px}
#bikeCtl button.on{transform:scale(.92);filter:brightness(1.35)}
#spd{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);background:var(--glass);border:1px solid var(--line);border-radius:16px;padding:8px 16px;font-weight:900;font-size:20px;color:#ffd66b}
#miniW{display:flex;flex-direction:column;gap:6px;align-items:flex-start;pointer-events:auto}
#mini{position:relative;width:112px;height:112px;border-radius:18px;overflow:hidden;border:2px solid #ffffff66;box-shadow:0 4px 16px #0008;background:#1d3a24;cursor:pointer}
#mini canvas{width:100%;height:100%;display:block}
#mini::after{content:'\1F5FA\FE0F';position:absolute;right:4px;bottom:1px;font-size:13px}
#routeInfo{display:none;background:var(--glass);border:1px solid var(--line);border-radius:12px;padding:5px 9px;font-size:11px;max-width:160px;cursor:pointer}
#bigMap{position:fixed;inset:0;z-index:6;background:#070b16ee;display:none;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:8px}
#bigMap canvas{border:2px solid #ffffff55;border-radius:12px;touch-action:none}
#bmBar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:center}
#bmBar button,#bmChips button{background:#34234e;border:1px solid #fff4;color:#fff;border-radius:10px;font-size:12px;padding:6px 10px;font-weight:700}
#bmChips{display:flex;gap:6px;overflow-x:auto;max-width:96vw;padding-bottom:2px}#bmChips button{white-space:nowrap}
#hpW{position:relative;width:112px;height:17px;border-radius:9px;background:#000a;border:2px solid #ffffff66;overflow:hidden;box-shadow:0 3px 10px #0007}
#hpB{height:100%;width:100%;background:#37d46a;transition:width .2s,background .2s}
#hpT{position:absolute;inset:0;text-align:center;font-size:11px;font-weight:900;line-height:13px;text-shadow:0 1px 2px #000}
#hitFlash{position:fixed;inset:0;pointer-events:none;background:radial-gradient(#0000 35%,#e00c);opacity:0;transition:opacity .25s;z-index:4}
#deadScr{position:fixed;inset:0;z-index:7;background:#000c;display:none;align-items:center;justify-content:center;text-align:center;font-size:22px;font-weight:900;color:#ff6a6a;pointer-events:none}
#hitBtn{grid-column:span 2;height:54px;background:linear-gradient(135deg,#ff5a5a,#b01c2c);font-size:16px;border:2px solid #ffffff80}
#hitBtn:active{transform:scale(.94)}
</style>
</head>
